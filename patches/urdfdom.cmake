set(path "$ENV{SOURCE_DIR}/CMakeLists.txt")
file(READ "${path}" content)
set(old "add_custom_target(uninstall\n  \"\${CMAKE_COMMAND}\" -P \"\${PROJECT_BINARY_DIR}/uninstall.cmake\")")
set(new "if(NOT TARGET uninstall)\n  add_custom_target(uninstall\n    \"\${CMAKE_COMMAND}\" -P \"\${PROJECT_BINARY_DIR}/uninstall.cmake\")\nendif()")
string(FIND "${content}" "${old}" position)
if(position EQUAL -1)
    message(FATAL_ERROR "Expected uninstall target definition not found in ${path}")
endif()
string(REPLACE "${old}" "${new}" content "${content}")
file(WRITE "${path}" "${content}")
