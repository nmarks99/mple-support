ExternalProject_Add(
    ompl
    GIT_REPOSITORY https://github.com/ompl/ompl.git
    GIT_TAG ${MPLE_SUPPORT_OMPL_REVISION}
    GIT_SHALLOW FALSE
    UPDATE_DISCONNECTED TRUE
    INSTALL_DIR ${MPLE_SUPPORT_INSTALL_PREFIX}
    DEPENDS eigen
    CMAKE_ARGS
        ${MPLE_SUPPORT_CMAKE_ARGS}
        -DOMPL_BUILD_SHARED=${MPLE_SUPPORT_BUILD_SHARED_LIBS}
        -DOMPL_BUILD_TESTS=OFF
        -DOMPL_BUILD_DEMOS=OFF
        -DOMPL_BUILD_PYTHON_BINDINGS=OFF
        -DOMPL_BUILD_VAMP=OFF
)
