ExternalProject_Add(
    coal
    GIT_REPOSITORY https://github.com/coal-library/coal.git
    GIT_TAG ${MPLE_SUPPORT_COAL_REVISION}
    GIT_SHALLOW FALSE
    GIT_SUBMODULES cmake
    UPDATE_DISCONNECTED TRUE
    INSTALL_DIR ${MPLE_SUPPORT_INSTALL_PREFIX}
    DEPENDS eigen assimp
    CMAKE_ARGS
        ${MPLE_SUPPORT_CMAKE_ARGS}
        -DBUILD_PYTHON_INTERFACE=OFF
        -DINSTALL_DOCUMENTATION=OFF
        -DCOAL_HAS_QHULL=OFF
        -DCMAKE_DISABLE_FIND_PACKAGE_octomap=ON
)
