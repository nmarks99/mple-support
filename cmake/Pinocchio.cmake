ExternalProject_Add(
    tinyxml2
    GIT_REPOSITORY https://github.com/leethomason/tinyxml2.git
    GIT_TAG ${MPLE_SUPPORT_TINYXML2_REVISION}
    GIT_SHALLOW FALSE
    UPDATE_DISCONNECTED TRUE
    INSTALL_DIR ${MPLE_SUPPORT_INSTALL_PREFIX}
    CMAKE_ARGS
        ${MPLE_SUPPORT_CMAKE_ARGS}
        -Dtinyxml2_BUILD_TESTING=OFF
)

ExternalProject_Add(
    console_bridge
    GIT_REPOSITORY https://github.com/ros/console_bridge.git
    GIT_TAG ${MPLE_SUPPORT_CONSOLE_BRIDGE_REVISION}
    GIT_SHALLOW FALSE
    UPDATE_DISCONNECTED TRUE
    INSTALL_DIR ${MPLE_SUPPORT_INSTALL_PREFIX}
    CMAKE_ARGS ${MPLE_SUPPORT_CMAKE_ARGS}
)

ExternalProject_Add(
    urdfdom_headers
    GIT_REPOSITORY https://github.com/ros/urdfdom_headers.git
    GIT_TAG ${MPLE_SUPPORT_URDFDOM_HEADERS_REVISION}
    GIT_SHALLOW FALSE
    UPDATE_DISCONNECTED TRUE
    INSTALL_DIR ${MPLE_SUPPORT_INSTALL_PREFIX}
    CMAKE_ARGS
        ${MPLE_SUPPORT_CMAKE_ARGS}
        -DAPPEND_PROJECT_NAME_TO_INCLUDEDIR=OFF
)

ExternalProject_Add(
    urdfdom
    GIT_REPOSITORY https://github.com/ros/urdfdom.git
    GIT_TAG ${MPLE_SUPPORT_URDFDOM_REVISION}
    GIT_SHALLOW FALSE
    UPDATE_DISCONNECTED TRUE
    INSTALL_DIR ${MPLE_SUPPORT_INSTALL_PREFIX}
    DEPENDS tinyxml2 console_bridge urdfdom_headers
    CMAKE_ARGS
        ${MPLE_SUPPORT_CMAKE_ARGS}
        -DAPPEND_PROJECT_NAME_TO_INCLUDEDIR=OFF
)

ExternalProject_Add(
    pinocchio
    GIT_REPOSITORY https://github.com/stack-of-tasks/pinocchio.git
    GIT_TAG ${MPLE_SUPPORT_PINOCCHIO_REVISION}
    GIT_SHALLOW FALSE
    GIT_SUBMODULES cmake
    UPDATE_DISCONNECTED TRUE
    INSTALL_DIR ${MPLE_SUPPORT_INSTALL_PREFIX}
    DEPENDS eigen urdfdom
    CMAKE_ARGS
        ${MPLE_SUPPORT_CMAKE_ARGS}
        -DBUILD_PYTHON_INTERFACE=OFF
        -DBUILD_EXAMPLES=OFF
        -DBUILD_BENCHMARK=OFF
        -DBUILD_UTILS=OFF
        -DBUILD_WITH_URDF_SUPPORT=ON
        -DBUILD_WITH_COLLISION_SUPPORT=OFF
        -DPINOCCHIO_BUILD_VISUALIZERS=OFF
        -DINSTALL_DOCUMENTATION=OFF
)
