MPLE_SUPPORT_PREFIX = $(MPLE_SUPPORT)/install/$(EPICS_HOST_ARCH)
MPLE_SUPPORT_INCLUDE = $(MPLE_SUPPORT_PREFIX)/@CMAKE_INSTALL_INCLUDEDIR@
MPLE_SUPPORT_LIB = $(MPLE_SUPPORT_PREFIX)/@CMAKE_INSTALL_LIBDIR@

MPLE_SUPPORT_INCLUDES = \
    -isystem $(MPLE_SUPPORT_INCLUDE) \
    -isystem $(MPLE_SUPPORT_INCLUDE)/eigen3 \
    -isystem $(MPLE_SUPPORT_INCLUDE)/ompl-2.0

toppra_DIR = $(MPLE_SUPPORT_LIB)
ompl_DIR = $(MPLE_SUPPORT_LIB)
pinocchio_default_DIR = $(MPLE_SUPPORT_LIB)
pinocchio_parsers_DIR = $(MPLE_SUPPORT_LIB)
