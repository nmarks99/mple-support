MPLE_SUPPORT_PREFIX = $(MPLE_SUPPORT)/install/$(EPICS_HOST_ARCH)
MPLE_SUPPORT_INCLUDE = $(MPLE_SUPPORT_PREFIX)/@CMAKE_INSTALL_INCLUDEDIR@
MPLE_SUPPORT_LIB = $(MPLE_SUPPORT_PREFIX)/@CMAKE_INSTALL_LIBDIR@

MPLE_SUPPORT_INCLUDES = \
    -isystem $(MPLE_SUPPORT_INCLUDE) \
    -isystem $(MPLE_SUPPORT_INCLUDE)/eigen3 \
    -isystem $(MPLE_SUPPORT_INCLUDE)/ompl-2.0

# Must match INTERFACE_COMPILE_DEFINITIONS in the installed pinocchioTargets.cmake
MPLE_SUPPORT_CPPFLAGS = \
    -DBOOST_MPL_LIMIT_LIST_SIZE=30 \
    -DBOOST_MPL_LIMIT_VECTOR_SIZE=30 \
    -DBOOST_MPL_CFG_NO_PREPROCESSED_HEADERS \
    -DBOOST_FUSION_INVOKE_MAX_ARITY=12 \
    -DPINOCCHIO_ENABLE_TEMPLATE_INSTANTIATION \
    -DPINOCCHIO_WITH_COLLISION \
    -DPINOCCHIO_WITH_HPP_FCL \
    -DPINOCCHIO_WITH_URDFDOM \
    -DPINOCCHIO_URDFDOM_HEADERS_MAJOR_VERSION=3 \
    -DPINOCCHIO_URDFDOM_HEADERS_MINOR_VERSION=0 \
    -DPINOCCHIO_URDFDOM_HEADERS_PATCH_VERSION=1

toppra_DIR = $(MPLE_SUPPORT_LIB)
ompl_DIR = $(MPLE_SUPPORT_LIB)
pinocchio_default_DIR = $(MPLE_SUPPORT_LIB)
pinocchio_parsers_DIR = $(MPLE_SUPPORT_LIB)
pinocchio_collision_DIR = $(MPLE_SUPPORT_LIB)
coal_DIR = $(MPLE_SUPPORT_LIB)
